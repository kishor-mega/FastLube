PORT=5000
NODE_ENV=development

# Frontend URL (Netlify / Vercel) — required for CORS in production
CLIENT_URL=http://localhost:3000

# Extra origins, comma-separated (preview URLs, custom domains)
# ALLOWED_ORIGINS=https://fastlube.netlify.app,https://www.yoursite.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/fastlube

# Long random string — never commit the real value
JWT_SECRET=change-this-to-a-long-random-string
